+"""Tests for the Todo CLI core logic."""
+
+import json
+import os
+
+import pytest
+
+from todo import core
+
+
+@pytest.fixture
+def todo_file(tmp_path):
+    """Return a path to a temporary todos.json file."""
+    return str(tmp_path / "todos.json")
+
+
+def test_add_todo(todo_file):
+    todo = core.add_todo("Buy milk", todo_file)
+    assert todo["id"] == 1
+    assert todo["text"] == "Buy milk"
+    assert todo["done"] is False
+
+    # Verify persistence
+    assert os.path.exists(todo_file)
+    with open(todo_file, "r", encoding="utf-8") as f:
+        data = json.load(f)
+    assert data == [{"id": 1, "text": "Buy milk", "done": False}]
+
+
+def test_add_multiple_todos_assigns_incrementing_ids(todo_file):
+    core.add_todo("First", todo_file)
+    core.add_todo("Second", todo_file)
+    core.add_todo("Third", todo_file)
+
+    todos = core.list_todos(todo_file)
+    assert [t["id"] for t in todos] == [1, 2, 3]
+
+
+def test_list_todos_empty(todo_file):
+    assert core.list_todos(todo_file) == []
+
+
+def test_list_todos_returns_saved(todo_file):
+    core.add_todo("A", todo_file)
+    core.add_todo("B", todo_file)
+    todos = core.list_todos(todo_file)
+    assert len(todos) == 2
+    assert todos[0]["text"] == "A"
+    assert todos[1]["text"] == "B"
+
+
+def test_mark_done(todo_file):
+    core.add_todo("Task", todo_file)
+    todo = core.mark_done(1, todo_file)
+    assert todo is not None
+    assert todo["done"] is True
+
+    todos = core.list_todos(todo_file)
+    assert todos[0]["done"] is True
+
+
+def test_mark_done_not_found(todo_file):
+    assert core.mark_done(99, todo_file) is None
+
+
+def test_remove_todo(todo_file):
+    core.add_todo("Task", todo_file)
+    removed = core.remove_todo(1, todo_file)
+    assert removed is not None
+    assert removed["id"] == 1
+    assert core.list_todos(todo_file) == []
+
+
+def test_remove_todo_not_found(todo_file):
+    assert core.remove_todo(99, todo_file) is None
+
+
+def test_load_todos_missing_file(todo_file):
+    assert core.load_todos(todo_file) == []
+
+
+def test_load_todos_corrupt_file(todo_file):
+    with open(todo_file, "w", encoding="utf-8") as f:
+        f.write("not valid json")
+    assert core.load_todos(todo_file) == []
+
+
+def test_next_id_after_removal(todo_file):
+    core.add_todo("A", todo_file)
+    core.add_todo("B", todo_file)
+    core.remove_todo(1, todo_file)
+    todo = core.add_todo("C", todo_file)
+    assert todo["id"] == 3

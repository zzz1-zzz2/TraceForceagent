@@ -0,0 +1,77 @@
+"""Core logic for the Todo CLI."""
+
+import json
+import os
+
+DEFAULT_FILE = "todos.json"
+
+
+def load_todos(path=DEFAULT_FILE):
+    """Load todos from the JSON file. Returns a list of dicts."""
+    if not os.path.exists(path):
+        return []
+    with open(path, "r", encoding="utf-8") as f:
+        try:
+            data = json.load(f)
+        except json.JSONDecodeError:
+            return []
+    if not isinstance(data, list):
+        return []
+    return data
+
+
+def save_todos(todos, path=DEFAULT_FILE):
+    """Save todos to the JSON file."""
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(todos, f, ensure_ascii=False, indent=2)
+
+
+def next_id(todos):
+    """Return the next available id."""
+    if not todos:
+        return 1
+    return max(todo.get("id", 0) for todo in todos) + 1
+
+
+def add_todo(text, path=DEFAULT_FILE):
+    """Add a new todo and return it."""
+    todos = load_todos(path)
+    todo = {"id": next_id(todos), "text": text, "done": False}
+    todos.append(todo)
+    save_todos(todos, path)
+    return todo
+
+
+def list_todos(path=DEFAULT_FILE):
+    """Return the list of todos."""
+    return load_todos(path)
+
+
+def find_todo(todos, todo_id):
+    """Find a todo by id, or return None."""
+    for todo in todos:
+        if todo.get("id") == todo_id:
+            return todo
+    return None
+
+
+def mark_done(todo_id, path=DEFAULT_FILE):
+    """Mark a todo as done. Returns the todo or None if not found."""
+    todos = load_todos(path)
+    todo = find_todo(todos, todo_id)
+    if todo is None:
+        return None
+    todo["done"] = True
+    save_todos(todos, path)
+    return todo
+
+
+def remove_todo(todo_id, path=DEFAULT_FILE):
+    """Remove a todo by id. Returns the removed todo or None if not found."""
+    todos = load_todos(path)
+    todo = find_todo(todos, todo_id)
+    if todo is None:
+        return None
+    todos = [t for t in todos if t.get("id") != todo_id]
+    save_todos(todos, path)
+    return todo

+"""Command-line interface for the Todo CLI."""
+
+import argparse
+import sys
+
+from todo import core
+
+
+def build_parser():
+    parser = argparse.ArgumentParser(prog="todo", description="A simple Todo CLI")
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    add_parser = subparsers.add_parser("add", help="Add a new todo")
+    add_parser.add_argument("text", help="The todo text")
+
+    subparsers.add_parser("list", help="List all todos")
+
+    done_parser = subparsers.add_parser("done", help="Mark a todo as done")
+    done_parser.add_argument("id", type=int, help="The todo id")
+
+    remove_parser = subparsers.add_parser("remove", help="Remove a todo")
+    remove_parser.add_argument("id", type=int, help="The todo id")
+
+    return parser
+
+
+def main(argv=None):
+    parser = build_parser()
+    args = parser.parse_args(argv)
+
+    if args.command == "add":
+        todo = core.add_todo(args.text)
+        print(f"Added todo #{todo['id']}: {todo['text']}")
+    elif args.command == "list":
+        todos = core.list_todos()
+        if not todos:
+            print("No todos.")
+            return 0
+        for todo in todos:
+            status = "[x]" if todo.get("done") else "[ ]"
+            print(f"{status} {todo['id']}: {todo['text']}")
+    elif args.command == "done":
+        todo = core.mark_done(args.id)
+        if todo is None:
+            print(f"Todo #{args.id} not found.", file=sys.stderr)
+            return 1
+        print(f"Marked todo #{todo['id']} as done.")
+    elif args.command == "remove":
+        todo = core.remove_todo(args.id)
+        if todo is None:
+            print(f"Todo #{args.id} not found.", file=sys.stderr)
+            return 1
+        print(f"Removed todo #{todo['id']}: {todo['text']}")
+
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

# TraceForce configuration template
#
# Copy this file to a path of your choice (e.g. `~/traceforce.env`) and fill in
# your real values. NEVER commit the populated file.
#
# TraceForce will only read this file when you pass it explicitly:
#
#   python -m coding_agent --env-file ~/traceforce.env tui
#   python -m coding_agent --env-file ~/traceforce.env check
#
# The workspace's own `.env` is intentionally NOT auto-loaded.

# === Active provider ===
# One of: deepseek | openai | glm | qwen | kimi
ACTIVE_PROVIDER=deepseek

# === Provider-specific API keys (set ONLY the one matching ACTIVE_PROVIDER) ===
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-your-openai-key
GLM_API_KEY=your-glm-key
QWEN_API_KEY=your-qwen-key
KIMI_API_KEY=your-kimi-key

# === Cross-provider override (optional) ===
# Only used when the provider-specific key above is missing. Useful if you
# rotate credentials in one place.
# TRACEFORCE_API_KEY=sk-your-universal-key

# === Provider endpoints / model overrides (optional) ===
# Defaults are baked in; override only if you self-host a compatible gateway.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# ACTIVE_MODEL=deepseek-chat
# ACTIVE_BASE_URL=https://api.deepseek.com/v1

# === Agent behaviour (optional; CLI flags take precedence) ===
MAX_STEPS=50
MAX_MODEL_CALLS=80
MAX_WALL_TIME=1800
COMMAND_TIMEOUT=60
MAX_TOOL_OUTPUT=50000
CONTEXT_BUDGET=32000
TEMPERATURE=0.0

# === Mode switches ===
ENABLE_FAILURE_REFRESH=true
BENCHMARK_MODE=false

# === Logging ===
LOG_LEVEL=INFO
LOG_JSON=true
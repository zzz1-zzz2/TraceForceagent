# TraceForce configuration template
#
# This file is a *template*. TraceForce will only read a real env file when
# you pass it explicitly:
#
#   coding-agent --env-file ~/traceforce.env check
#   coding-agent --env-file ~/traceforce.env tui --workspace ~/work/my-project
#
# The workspace's own `.env` is intentionally NOT auto-loaded.
# TOML config in ~/.config/traceforce/config.toml accepts only
# non-sensitive overrides (active_provider, active_model, temperature,
# max_steps, …). It will silently drop api_key, *_TOKEN, *_SECRET,
# permission_policy, sandbox.
#
# Empty values are required: leaving a provider's key empty tells the
# resolver to ignore it. Do NOT paste placeholder-looking values like
# `sk-your-deepseek-key` here — the resolver cannot tell those apart
# from real keys and will hand them to the SDK.

# === Active provider ===
# One of: deepseek | openai | glm | qwen | kimi
ACTIVE_PROVIDER=deepseek

# === Provider-specific API keys ===
# Set ONLY the key matching ACTIVE_PROVIDER; leave the others empty.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GLM_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=

# === Cross-provider override (optional) ===
# Used only when the provider-specific key above is missing. Useful for
# rotating credentials in one place.
# TRACEFORCE_API_KEY=

# === Provider endpoints / model overrides (optional) ===
# Defaults are baked in; override only if you self-host a compatible gateway.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# ACTIVE_MODEL=deepseek-chat
# ACTIVE_BASE_URL=https://api.deepseek.com/v1

# === Agent behaviour (optional; CLI flags take precedence) ===
MAX_STEPS=50
MAX_MODEL_CALLS=80
MAX_WALL_TIME=1800
COMMAND_TIMEOUT=60
MAX_TOOL_OUTPUT=50000
CONTEXT_BUDGET=32000
TEMPERATURE=0.0

# === Mode switches ===
ENABLE_FAILURE_REFRESH=true

# === Logging ===
LOG_LEVEL=INFO
LOG_JSON=false